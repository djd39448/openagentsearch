/**
 * OpenAgentSearch public endpoint (Cloudflare Worker, Free plan).
 * Build + deploy from a Linux/WSL shell with Node >= 22: `npm ci && npx wrangler deploy`.
 * Nothing here is deployed by this repository's tests; see docs/api.md for the operator procedure.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openagentsearch",
  "main": "src/index.js",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Custom domain (2026-09-29): the zone `flopsearch.com` is registered in the same Cloudflare account, so
  // `wrangler deploy` creates the DNS record and certificate itself. `workers_dev` MUST stay explicitly true: once
  // `routes` exist wrangler disables the workers.dev hostname unless told otherwise (it did, on the first deploy), and
  // every published link points at `openagentsearch.trustcoresystems.workers.dev`.
  "workers_dev": true,
  "routes": [
    { "pattern": "flopsearch.com", "custom_domain": true }
  ],
  // Workers Rate Limiting binding (GA): 60 requests per 60 s per key (client IP), per Cloudflare location.
  // The handler fails closed to 503 if this binding is missing.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ]
}
